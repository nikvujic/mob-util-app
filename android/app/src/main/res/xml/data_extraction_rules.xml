<?xml version="1.0" encoding="utf-8"?>
<!-- Android's automatic backup (Android 12 on) and moving to a new phone:
     everything but the Documents page (see backup_rules.xml). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_flutter/data/documents.json" />
        <exclude domain="root" path="app_flutter/data/documents/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_flutter/data/documents.json" />
        <exclude domain="root" path="app_flutter/data/documents/" />
    </device-transfer>
</data-extraction-rules>
